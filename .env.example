# ==============================================================================
# StayHub - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (or '.env.local') and provide your real API credentials.
# NEVER commit real keys or secrets to Git or share publicly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Maps Platform & Places API
# ------------------------------------------------------------------------------
# Required for Palanpur real property location search, geocoding & directions.
# Enable in Google Cloud Console:
#   - Places API (New or TextSearch)
#   - Maps JavaScript API
#   - Geocoding API
#   - Directions API
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------------------------------
# 2. Property Listing & Rental Data API
# ------------------------------------------------------------------------------
# Authorized property listing / municipal rental registry API credentials.
# Used by the backend synchronization engine to import verified rental listings.
PROPERTY_API_KEY=
PROPERTY_API_BASE_URL=
VITE_PROPERTY_API_KEY=
VITE_PROPERTY_API_BASE_URL=

# ------------------------------------------------------------------------------
# 3. Authorized Media & Asset Source API
# ------------------------------------------------------------------------------
# API key for authorized property media sources (images, videos, floorplans).
MEDIA_API_KEY=
VITE_MEDIA_API_KEY=

# ------------------------------------------------------------------------------
# 4. Backend Service & Server Base URL
# ------------------------------------------------------------------------------
# Base URL for the Django REST framework backend.
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# 5. Firebase Authentication
# ------------------------------------------------------------------------------
# Used for user authentication (Guest, Owner, Admin roles).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 6. AI Assistant Service (Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 7. Django Backend Settings
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-in-production
DEBUG=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
