# StayHub Environment Variables Example

# Gemini API Key (Existing)
GEMINI_API_KEY=""

# Firebase Authentication (Existing)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Geocoding API Key (Default uses free Photon / OpenStreetMap without API key)
# If using Geoapify or LocationIQ, paste your key here:
VITE_GEOCODING_API_KEY=""
